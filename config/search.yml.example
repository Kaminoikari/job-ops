# 104 搜尋條件
# 注意：搜尋只是「廣度撈取」；真正的納入門檻是 JD/title 必須出現 AI 關鍵字
#（沒有 AI 訊號的職缺會在 job_ops/ai_intent.py 的 has_ai 門檻一律剔除）。
keywords:
  # AI PM 高權重目標角色（req: 列為高權重關鍵字）
  - AI 產品經理
  - AI Product Manager
  - AI Product Builder
  - 產品總監
  - 產品長
  - Product Builder
  # 寬詞（PM 紅海大詞；104 是相關性排序，冷門領域的 PM 缺在寬詞下易排到數百名外）
  - 產品經理
  - Product Manager
  - 資深產品經理
  # 領域窄詞：撈出 title 被 AI/領域字稀釋、在 PM 寬詞下排序沉底的缺
  # （例：「AI 產品經理_先進工業電腦視覺」在「產品經理」排 865 名，在「電腦視覺」排第 9 名）
  - 電腦視覺
  # 職稱窄詞：PM 家族裡不叫「產品經理」的職稱，在寬詞下排到數百名外，
  # 用職稱本身當關鍵字就排在前兩頁（例：「產品規劃師」全站僅 81 筆）
  - 產品規劃師
  - 產品管理師
  # 領域窄詞：digital twin / embodied AI / sim-to-real（每個各自獨立撈取，
  # 中英文都列因 104 keyword 為字面比對；AI 硬門檻 + PM 職稱過濾會自動收斂成 PM 缺）
  - 數位孿生
  - 數位分身
  - Digital Twin
  - 具身智能
  - 具身智慧
  - Embodied AI
  - Sim-to-Real
  - Sim2Real
  - Physical AI

# 104 職務類別代碼（職類精準涵蓋，撈 title 不含關鍵字但職類掛 PM 的缺）
# 代碼查 https://static.104.com.tw/category-tool/json/JobCat.json
# 注意：jobcat 查詢一樣吃相關性排序，單靠它救不了「排序沉底」；
# 要壓縮母體請搭配下面的 jobcat_recency_days
jobcats:
  - "2004003009"      # 產品經理
  - "2004003004"      # 其他專案管理師

# 只對 jobcat 查詢套用的「近 N 天更新」窗口（送 104 的 isnew 參數）。
# 合法值只有 0 / 3 / 7 / 14 / 30（其餘值 104 回 400），0 = 僅今日；null = 不限。
# 職類查詢動輒數千筆（「產品經理」職類在台北/新北/新竹/海外有 5,623 筆），
# max_pages=5 只看得到前 152 筆；加上時間窗才能讓固定頁數覆蓋到有意義的比例。
# keyword 查詢刻意不套用，保留一份不受時間窗限制的廣度掃描。
jobcat_recency_days: 3

areas:
  - 台北市
  - 新北市
  - 新竹市
  - 海外地區          # 含中國、日本、東南亞、北美、歐洲等所有海外職缺

# 每組 keyword / jobcat 最多翻幾頁（每頁約 20 筆）
# 第一次撈歷史可以拉高到 50；日常運作 5 通常足夠
max_pages_per_keyword: 5

# 只保留 appearDate >= 此日期的職缺；YYYY-MM-DD
# 第一次 bootstrap 撈歷史時設定（例如 "2026-04-01"），日常運作可註解掉或設為 null
# 純客戶端過濾，不會減少翻頁次數（104 不是按更新日排序，無法據此提早停止翻頁）
from_date: null

# 過濾條件
filters:
  # 月薪低於此值剔除；單位：新台幣
  min_salary_monthly: 60000

  # 「面議」/「待遇面議」職缺一律保留（不被 min_salary_monthly 剔除）
  include_negotiable_salary: true

  # 職位名稱包含這些字詞 → 排除
  exclude_keywords:
    - 實習
    - 兼職
    - 工讀
    - 派遣

  # 公司名稱包含這些字詞 → 排除
  exclude_companies: []
